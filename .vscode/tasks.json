{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure GD32 Debug",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/configure.ps1",
        "-BuildType",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build GD32 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "build-debug"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "Configure GD32 Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Flash GD32 Debug",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/flash.ps1",
        "-BuildType",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build + Flash GD32",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build GD32 Debug",
        "Flash GD32 Debug"
      ],
      "problemMatcher": []
    }
  ]
}

